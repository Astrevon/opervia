# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL).
# Never commit .env.local.

# --- Public (safe in the browser) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_…). The legacy "anon" key also works:
# you can set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the app, used in email links (sign-up confirmation,
# password reset) and invitation links.
#   Local / LAN: leave EMPTY — links then use whatever address you opened the app with.
#   Production:  https://your-app.vercel.app (or your own domain)
NEXT_PUBLIC_SITE_URL=

# Optional: makes the "Made by Opervia" badge a link.
NEXT_PUBLIC_OPERVIA_URL=

# --- Server-only secret — scripts only, NEVER exposed to the browser --------
# Needed ONLY for `npm run seed:demo` and `npm run test:integration`.
# The running app does not use it. Do not add it to Vercel.
# The "secret" key (sb_secret_…). The legacy "service_role" key also works:
# you can set SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=

# Optional: fixed password for all demo users (min 10 chars, letter + number).
# Leave empty to generate a unique random password per demo user.
DEMO_PASSWORD=
